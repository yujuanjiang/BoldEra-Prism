NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional for local write/update controls. Prefer service role only on trusted local machines.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key

# Optional fallback for the Streamlit reader if the Supabase Data API points at a different/empty view.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
